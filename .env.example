# Configuration AMIBIOMED

PORT=3000
NODE_ENV=production

# Base de données PostgreSQL (Fournie automatiquement par Railway si vous ajoutez un service PostgreSQL)
# Exemple Railway : DATABASE_URL=${{Postgres.DATABASE_URL}}
