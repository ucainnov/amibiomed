SMTP_USER=qcmuca@gmail.com
SMTP_PASS=qcoc yqgq uaet yntr
SMTP_FROM="AMIBIOMED" <qcmuca@gmail.com>

# Identifiants Administrateur initial (créé automatiquement au premier démarrage si la base est vide)
